#!/usr/bin/env bash
set -euo pipefail

echo "[test] Linking local inferssd plugin..."
mise plugins link --force inferssd .
mise cache clear

echo "[test] Ensuring prerequisite uv is installed..."
mise use -g uv@latest || mise install uv@latest

echo "[test] Installing inferssd@v0.1.4..."
mise install inferssd@v0.1.4

echo "[test] Verifying InferSSD installation and CLI shims..."
mise exec inferssd@v0.1.4 -- inferssd --version --json
mise exec inferssd@v0.1.4 -- inferssd cli --help
mise exec inferssd@v0.1.4 -- inferssd serve --help

echo "[test] Verified InferSSD successfully provisioned."